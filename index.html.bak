<!DOCTYPE html>
<html lang="en" id="mode" data-theme="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="index_style.css">
    <title>NX</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="apple-touch-icon" sizes="180x180" href="assets/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="assets/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="assets/favicon-16x16.png">
    <link rel="manifest" href="assets/site.webmanifest">
</head>

<body>
<hr class="divider">
    <div>
        <video id="vid1" src="assets/eronium_chill.mp4" loop playsinline autoplay aria-hidden="true"></video>
    </div>

    <div>
        <video id="vid2" src="assets/eronium_wave.mp4"  loop playsinline autoplay aria-hidden="true"></video>
    </div>

    <div class="mii-gif-left">
        <canvas id="MiiChar1" width="300" height="300" aria-hidden="true"></canvas>

    </div>

    <div class="mii-gif-right">
        <canvas id="MiiChar2" width="300" height="300" aria-hidden="true"></canvas>
    </div>

    <button class="ldtoggle" id="LDToggle" aria-label="Toggle light and dark mode"><i id="modo"  class="fas fa-sun fas fa-moon" aria-hidden="true"></i></button>

    <main class="main">  
    <div class="logo-box">
        <img class="logo" id="logo_light" src="assets/logo_almond.PNG" alt="NX logo">
        <img class="hidden logo2" id="logo_dark"  src="assets/logo_black.PNG" alt="NX logo">
    </div>      

    <h1>Welcome to NX.</h1>
    <p>An archive of my works.</p>
    </main>

    <section class="selections" id="selections">
        <a href="pages/about.html" id="about" data-message="Get to know who I am and my journey so far."><span> About Me</span></a>
        <a href="pages/btv.html" id="btv" data-message="Somewhere, Nowhere, Yet Still There. Take a peek at the story I am developing, Beyond The Veil."><span> Beyond The Veil</span></a> 
        <a href="pages/music.html" id="music" data-message="Check out everything and anything related to my music!"><span> Music </span></a>
        <a href="pages/cs_projects.html" id="proj" data-message="All of my finished and in progress projects."><span> Projects </span></a>
    </section>
    
    <div class="outer-screen">
        <div class="inner-screen">
            <p id="screen-text"></p>
        </div>
    </div>

    <footer class="footer">
        <p>Eronium 2026</p>

    </footer>
<script src="index_script.js"></script>
</body>


</html>